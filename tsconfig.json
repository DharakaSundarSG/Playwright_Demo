{
  "compilerOptions": {

    "module": "NodeNext",

    "target": "ESNext",

    "lib": ["ESNext"],

    "types": ["node"],

    "sourceMap": true,

    "declaration": true,

    "declarationMap": true,

    "strict": true,

    "jsx": "react-jsx",

    "verbatimModuleSyntax": false,

    "isolatedModules": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "esModuleInterop": true
  }
}
